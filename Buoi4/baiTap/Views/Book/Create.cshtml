@model baiTap.Models.Book

@{
    ViewData["Title"] = "Thêm sách mới";
}

<h2>Thêm sách mới (Bài 3 - Validation)</h2>

<form asp-action="Create" method="post">
    <!-- Hiển thị tổng hợp lỗi ở đầu form nếu có -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-group mb-3">
        <label asp-for="Name" class="form-label">Tên sách</label>
        <input asp-for="Name" class="form-control" />
        <!-- Dòng hiển thị lỗi khi tên bị rỗng -->
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price" class="form-label">Giá sách</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <!-- Dòng hiển thị lỗi khi giá <= 0 -->
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu sách</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}